generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PreguntaRespuesta {
  id        Int    @id @default(autoincrement())
  pregunta  String
  respuesta String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Usuario {
  id           Int      @id @default(autoincrement())
  usuario      String   @unique
  passwordHash String
  rol          String   @default("admin")
  createdAt    DateTime @default(now())
}

model ChatHistorico {
  id         Int      @id @default(autoincrement())
  folio      String   @unique
  expediente String? 
  mensajes   Json
  createdAt  DateTime @default(now())
}
